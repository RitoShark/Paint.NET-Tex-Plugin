<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="TEX File Type Plugin for Paint.NET" 
           Manufacturer="TEX Plugin Developer" 
           Version="1.0.0.0" 
           UpgradeCode="A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />
    
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    
    <Property Id="WIXUI_WELCOMEDLG_TEXT" Value="This wizard will guide you through the installation of the TEX File Type Plugin for Paint.NET.&#13;&#10;&#13;&#10;Please ensure Paint.NET is closed before continuing.&#13;&#10;&#13;&#10;Click Next to continue." />
    
    <util:CloseApplication Id="ClosePaintDotNet" 
                          Target="PaintDotNet.exe" 
                          CloseMessage="yes" 
                          Description="Paint.NET must be closed before installation can continue. Please save your work and close Paint.NET."
                          RebootPrompt="no" />

    <Property Id="WixShellExecTarget" Value="powershell.exe" />
    <CustomAction Id="RestartExplorerInstall" 
                  Property="WixShellExecTarget"
                  ExeCommand="-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -Command &quot;Get-Process explorer | Stop-Process -Force; Start-Sleep -Seconds 1; Start-Process explorer.exe&quot;"
                  Execute="deferred" 
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RestartExplorerUninstall" 
                  Property="WixShellExecTarget"
                  ExeCommand="-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -Command &quot;Get-Process explorer | Stop-Process -Force; Start-Sleep -Seconds 1; Start-Process explorer.exe&quot;"
                  Execute="deferred" 
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="DeletePluginDll" 
                  Property="WixShellExecTarget"
                  ExeCommand="-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -Command &quot;Remove-Item -Path 'C:\Program Files\Paint.NET\FileTypes\TexFileType.dll' -Force -ErrorAction SilentlyContinue&quot;"
                  Execute="deferred" 
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RestartExplorerInstall" Before="InstallFinalize" Condition="NOT Installed AND $ThumbnailProviderDll=3" />
      <Custom Action="DeletePluginDll" Before="InstallFinalize" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RestartExplorerUninstall" Before="InstallFinalize" Condition="REMOVE~=&quot;ALL&quot; AND ?ThumbnailProviderDll=3" />
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" 
             Title="TEX File Type Plugin" 
             Description="Core plugin files for opening and saving TEX texture files in Paint.NET"
             Level="1" 
             Display="expand">
      <ComponentGroupRef Id="PluginFiles" />
      
      <Feature Id="ThumbnailProvider" 
               Title="Windows Explorer Thumbnails" 
               Description="Enables thumbnail previews for .tex files in Windows Explorer"
               Level="1"
               Display="expand">
        <ComponentGroupRef Id="ThumbnailProviderFiles" />
      </Feature>
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="PaintDotNetFolder" Name="Paint.NET">
        <Directory Id="FileTypesFolder" Name="FileTypes" />
      </Directory>
      <Directory Id="INSTALLFOLDER" Name="TexFileTypePlugin">
        <Directory Id="ThumbnailProviderFolder" Name="ThumbnailProvider" />
      </Directory>
    </StandardDirectory>
  </Package>

  <Fragment>
    <ComponentGroup Id="PluginFiles" Directory="FileTypesFolder">
      <Component Id="TexFileTypeDll" Guid="B2C3D4E5-F6A7-4B5C-9D0E-1F2A3B4C5D6E">
        <File Id="TexFileTypeDll" 
              Source="..\bin\Release\net9.0-windows\TexFileType.dll" 
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
    
    <ComponentGroup Id="ThumbnailProviderFiles" Directory="ThumbnailProviderFolder">
      <Component Id="ThumbnailProviderDll" Guid="C3D4E5F6-A7B8-4C5D-9E0F-1A2B3C4D5E6F">
        <File Id="ThumbnailProviderDll" 
              Source="TexThumbnailProvider.dll" 
              KeyPath="yes"
              SelfRegCost="1" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
